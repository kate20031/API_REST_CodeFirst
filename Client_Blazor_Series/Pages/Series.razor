\
@page "/series"
@using Client_Blazor_Series.ViewModels
@using System.ComponentModel
@implements IDisposable
@inject SeriesViewModel ViewModel

<PageTitle>Liste des séries</PageTitle>

<h1>Liste des séries</h1>

<div class="mb-3">
    <button class="btn btn-primary"
            @onclick="LoadFast"
            disabled="@ViewModel.LoadCommand.IsRunning">
        Recharger (rapide)
    </button>

    <button class="btn btn-secondary"
            @onclick="LoadSlow"
            disabled="@ViewModel.LoadCommand.IsRunning">
        Rechargement lent
    </button>

    @if (ViewModel.LoadCommand.CanBeCanceled)
    {
        <button class="btn btn-danger"
                @onclick="CancelLoad">
            Annuler
        </button>
    }
</div>

@if (ViewModel.LoadCommand.IsRunning)
{
    <p role="status">
        <span class="spinner-border spinner-border-sm"
              aria-hidden="true"></span>
        Chargement en cours...
    </p>
}

@if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
{
    <p role="status">@ViewModel.StatusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
{
    <p class="text-danger" role="alert">
        @ViewModel.ErrorMessage
    </p>
}

@if (ViewModel.Series.Count > 0)
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Titre</th>
                <th>Année de création</th>
                <th>Réseau</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var serie in ViewModel.Series)
            {
                <tr @key="serie.SerieId">
                    <td>@serie.SerieId</td>
                    <td>@serie.Titre</td>
                    <td>@(serie.AnneeCreation?.ToString() ?? "Inconnue")</td>
                    <td>@(serie.Network ?? "Inconnu")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary"
                           href="@($"/series/{serie.SerieId}")">
                            Détails / Modifier
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (!ViewModel.LoadCommand.IsRunning
         && string.IsNullOrEmpty(ViewModel.ErrorMessage))
{
    <p>Aucune série à afficher.</p>
}

@code {
    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        ViewModel.LoadCommand.PropertyChanged += OnCommandPropertyChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFast();
    }

    private void OnViewModelPropertyChanged(
        object? sender,
        PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnCommandPropertyChanged(
        object? sender,
        PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadFast()
    {
        await ViewModel.LoadCommand.ExecuteAsync(
            TimeSpan.FromSeconds(1));
    }

    private async Task LoadSlow()
    {
        await ViewModel.LoadCommand.ExecuteAsync(
            TimeSpan.FromSeconds(5));
    }

    private void CancelLoad()
    {
        ViewModel.LoadCommand.Cancel();
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
        ViewModel.LoadCommand.PropertyChanged -= OnCommandPropertyChanged;
    }
}
