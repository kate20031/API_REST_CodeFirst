@page "/series"
@using Client_Blazor_Series.ViewModels
@inject SeriesViewModel ViewModel

<PageTitle>Liste des séries</PageTitle>

<h1>Liste des séries</h1>

<div class="mb-3">
    <button class="btn btn-primary"
            @onclick="LoadSeries"
            disabled="@ViewModel.LoadSeriesCommand.IsRunning">
        Recharger
    </button>

    <button class="btn btn-secondary"
            @onclick="ReloadSlow"
            disabled="@isSlowLoading">
        Rechargement lent
    </button>

    @if (isSlowLoading)
    {
        <button class="btn btn-danger"
                @onclick="CancelSlowLoad">
            Annuler le chargement lent
        </button>
    }
</div>

@if (isSlowLoading || ViewModel.LoadSeriesCommand.IsRunning)
{
    <p role="status">
        <span class="spinner-border spinner-border-sm"
              aria-hidden="true"></span>
        Chargement en cours...
    </p>
}

@if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
{
    <p role="status">@ViewModel.StatusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
{
    <p class="text-danger" role="alert">
        @ViewModel.ErrorMessage
    </p>
}

@if (ViewModel.Series.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Titre</th>
                <th>Année de création</th>
                <th>Réseau</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var serie in ViewModel.Series)
            {
                <tr @key="serie.SerieId">
                    <td>@serie.SerieId</td>
                    <td>@serie.Titre</td>
                    <td>@(serie.AnneeCreation?.ToString() ?? "Inconnue")</td>
                    <td>@(serie.Network ?? "Inconnu")</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (!isSlowLoading &&
         !ViewModel.LoadSeriesCommand.IsRunning &&
         string.IsNullOrEmpty(ViewModel.ErrorMessage))
{
    <p>Aucune série à afficher.</p>
}

@code {
    private bool isSlowLoading;
    private CancellationTokenSource? slowLoadCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadSeries();
    }

    private async Task LoadSeries()
    {
        await ViewModel.LoadSeriesCommand.ExecuteAsync(null);
    }

    private async Task ReloadSlow()
    {
        if (isSlowLoading)
            return;

        isSlowLoading = true;
        slowLoadCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(5000, slowLoadCts.Token);
            await ViewModel.LoadSeriesCommand.ExecuteAsync(null);
        }
        catch (OperationCanceledException)
        {
            ViewModel.StatusMessage = "Chargement annulé.";
        }
        finally
        {
            isSlowLoading = false;
            slowLoadCts.Dispose();
            slowLoadCts = null;
        }
    }

    private void CancelSlowLoad()
    {
        slowLoadCts?.Cancel();
    }
}
